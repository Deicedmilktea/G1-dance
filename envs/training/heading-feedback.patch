--- /dev/null
+++ b/src/supermimic/heading_feedback.py
@@ -0,0 +1,30 @@
+"""Optional pelvis heading-error features shared by simulation and imagination."""
+
+from __future__ import annotations
+
+import torch
+
+from supermimic.kinematics.rotations import heading_yaw, quat_normalize
+
+HEADING_FEEDBACK_DIM = 2
+HEADING_FEEDBACK_MODES = ("off", "zero", "error")
+
+
+def heading_feedback_dim(mode: str) -> int:
+    if mode not in HEADING_FEEDBACK_MODES:
+        raise ValueError(f"Unknown heading feedback mode: {mode}")
+    return 0 if mode == "off" else HEADING_FEEDBACK_DIM
+
+
+def heading_feedback(robot_quat: torch.Tensor, reference_quat: torch.Tensor, mode: str) -> torch.Tensor:
+    """[sin(target_yaw - robot_yaw), cos(target_yaw - robot_yaw) - 1].
+
+    Quaternions use wxyz. Features are zero when aligned, continuous across the
+    +/-pi boundary, and unchanged by a common world-yaw rotation. The zero mode
+    keeps exactly the same interface as error mode without exposing the error.
+    """
+    dimension = heading_feedback_dim(mode)
+    if mode != "error":
+        return robot_quat.new_zeros((*robot_quat.shape[:-1], dimension))
+    error = heading_yaw(quat_normalize(reference_quat)) - heading_yaw(quat_normalize(robot_quat))
+    return torch.stack((torch.sin(error), torch.cos(error)-1.0), dim=-1)
